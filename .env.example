# Frontend (public, safe to ship to the browser). Copy to .env.local.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# DO NOT put ANTHROPIC_API_KEY here or in any VITE_ variable.
# It is a Supabase Edge Function secret:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
