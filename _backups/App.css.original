
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #f1f1f7;
  background: #0b0b10;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --bg: #0b0b10;
  --panel: #121219;
  --panel-light: #171720;
  --border: #262631;
  --muted: #9292a5;
  --purple: #9b83ff;
  --purple-light: #b5a2ff;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: var(--bg);
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible,
a:focus-visible {
  outline: 2px solid var(--purple);
  outline-offset: 3px;
}

.app-shell {
  min-height: 100vh;
  display: flex;
  background:
    radial-gradient(ellipse at 80% 0%, #20173530, transparent 40%),
    var(--bg);
}

/* SIDEBAR */

.sidebar {
  width: 258px;
  min-width: 258px;
  height: 100vh;
  position: sticky;
  top: 0;
  display: flex;
  flex-direction: column;
  padding: 25px 16px 16px;
  background: #0e0e14;
  border-right: 1px solid var(--border);
  z-index: 20;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 8px 25px;
  border-bottom: 1px solid var(--border);
}

.brand-logo {
  width: 41px;
  height: 41px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: linear-gradient(135deg, #a18aff, #6849ce);
  box-shadow: 0 5px 22px #8064ff35;
  color: white;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 24px;
  font-weight: 700;
}

.brand-name {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 1.1px;
}

.brand-sub {
  margin-top: 4px;
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 1.2px;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 11px;
  margin: 22px 0 30px;
  padding: 13px 11px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 13px;
}

.avatar, .top-avatar {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #765ce0, #b18aff);
  border-radius: 12px;
  font-weight: 700;
  color: white;
  font-size: 13px;
}

.profile-name {
  font-size: 13px;
  font-weight: 700;
}

.profile-role {
  color: var(--muted);
  font-size: 11px;
  margin-top: 4px;
}

.online-dot {
  width: 8px;
  height: 8px;
  background: #5cda9a;
  border-radius: 50%;
  margin-left: auto;
}

.nav-label {
  padding: 0 12px;
  color: #777789;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.6px;
  margin-bottom: 12px;
}

.nav-list {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 13px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: #9999ab;
  text-align: left;
  font-size: 13px;
  transition: all .2s;
}

.nav-item:hover {
  background: #1a1924;
  color: #fff;
}

.nav-active {
  background: #29213f;
  color: #c1b0ff;
  border-color: #49366f;
}

.nav-active svg {
  color: var(--purple-light);
}

.nav-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--purple);
  margin-left: auto;
}

.sidebar-bottom {
  margin-top: auto;
}

.sidebar-tip {
  background: linear-gradient(140deg, #1e1930, #15141d);
  border: 1px solid #37304d;
  border-radius: 13px;
  padding: 15px;
  margin-bottom: 16px;
}

.tip-icon {
  color: var(--purple-light);
  font-size: 20px;
  margin-bottom: 9px;
}

.tip-title {
  font-weight: 700;
  font-size: 13px;
}

.sidebar-tip p {
  font-size: 11px;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 0;
}

.version {
  padding: 14px 10px 0;
  font-size: 9px;
  letter-spacing: 1px;
  color: #626273;
}

.mobile-close {
  display: none !important;
}

/* MAIN AREA */

.main-area {
  flex: 1;
  min-width: 0;
}

.topbar {
  height: 76px;
  padding: 0 36px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--border);
  background: #0d0d13d9;
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(14px);
}

.topbar-left, .topbar-right {
  display: flex;
  align-items: center;
  gap: 17px;
}

.breadcrumb {
  color: #828294;
  font-size: 13px;
}

.breadcrumb span {
  margin: 0 9px;
  color: #4b4b59;
}

.breadcrumb strong {
  color: #e5e4ee;
  font-weight: 600;
}

.status-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #a4a4b6;
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 8px 12px;
  font-size: 11px;
}

.live-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: #62dca0;
  border-radius: 50%;
  box-shadow: 0 0 9px #62dca080;
}

.top-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
}

.menu-toggle {
  display: none !important;
}

.page-content {
  max-width: 1600px;
  margin: 0 auto;
  padding: 36px;
}

.welcome {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  margin-bottom: 30px;
}

.eyebrow {
  color: var(--purple-light);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  margin-bottom: 13px;
}

h1, h2, h3, p {
  margin-top: 0;
}

.welcome h1, .page-heading h1 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(25px, 3vw, 34px);
  letter-spacing: -1.2px;
  margin-bottom: 10px;
  line-height: 1.25;
}

.muted {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
  margin-bottom: 0;
}

.date-chip {
  display: flex;
  align-items: center;
  gap: 9px;
  white-space: nowrap;
  padding: 11px 15px;
  border: 1px solid var(--border);
  background: var(--panel);
  border-radius: 10px;
  color: #b4b4c5;
  font-size: 12px;
}

/* STATS */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 23px;
}

.stat-card {
  min-width: 0;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 15px;
  padding: 21px;
  transition: border-color .2s, transform .2s;
}

.stat-card:hover, .panel:hover {
  border-color: #393345;
}

.stat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  color: #a3a3b4;
  font-size: 12px;
}

.stat-icon {
  width: 37px;
  height: 37px;
  display: grid;
  place-items: center;
  border-radius: 11px;
}

.purple { background: #7c5ce625; color: #b5a2ff; }
.blue { background: #4287d525; color: #78baff; }
.green { background: #43c68b20; color: #62dca0; }
.orange { background: #f2a24d20; color: #f5b568; }

.stat-value {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 32px;
  font-weight: 700;
  margin: 18px 0 8px;
  letter-spacing: -1px;
}

.stat-value span {
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  color: #88889a;
  font-weight: 500;
  letter-spacing: 0;
}

.stat-foot {
  color: #777789;
  font-size: 11px;
}

.progress-track {
  height: 5px;
  background: #292834;
  border-radius: 20px;
  margin-top: 15px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #8e72ed, #b8a3ff);
  border-radius: 20px;
  transition: width .3s;
}

/* PANELS */

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(290px, 1fr);
  gap: 20px;
  align-items: start;
}

.panel {
  min-width: 0;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 23px;
  transition: border-color .2s;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 23px;
}

.panel-title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 17px;
  font-weight: 700;
}

.panel-subtitle {
  color: var(--muted);
  font-size: 12px;
  margin-top: 6px;
}

.primary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 14px;
  border: 1px solid #9278ed;
  border-radius: 9px;
  background: linear-gradient(135deg, #9278ed, #7556d2);
  color: white;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
  transition: all .2s;
}

.primary-btn:hover {
  filter: brightness(1.15);
  transform: translateY(-1px);
}

.task-form {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-bottom: 20px;
  padding: 14px;
  background: #191821;
  border: 1px solid var(--border);
  border-radius: 11px;
}

.task-form input {
  flex: 1;
  min-width: 100px;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #101016;
  color: white;
  font-size: 12px;
}

.task-form input::placeholder {
  color: #6f6f80;
}

.task-list, .habit-list {
  display: flex;
  flex-direction: column;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 16px 0;
  border-bottom: 1px solid #24242e;
}

.task-row:first-child {
  padding-top: 0;
}

.task-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.task-check, .habit-check {
  width: 21px;
  height: 21px;
  min-width: 21px;
  display: grid;
  place-items: center;
  border: 1px solid #484855;
  background: transparent;
  border-radius: 7px;
  color: white;
  padding: 0;
}

.task-check.checked, .habit-check.checked {
  background: #8c70e5;
  border-color: #8c70e5;
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-name {
  font-size: 13px;
  font-weight: 600;
  color: #e2e2ed;
  overflow-wrap: anywhere;
}

.task-name.done {
  text-decoration: line-through;
  color: #777789;
}

.task-meta {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-top: 7px;
  color: #818193;
  font-size: 11px;
}

.icon-btn {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: none;
  border-radius: 9px;
  background: transparent;
  color: #858596;
}

.icon-btn:hover {
  background: #24232e;
  color: white;
}

.delete-btn {
  opacity: 0;
  transition: opacity .2s;
}

.task-row:hover .delete-btn {
  opacity: 1;
}

.count-badge {
  color: #c4b4ff;
  background: #302747;
  border: 1px solid #49386d;
  border-radius: 8px;
  padding: 7px 10px;
  font-size: 12px;
  font-weight: 700;
}

.habit-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  border: none;
  border-bottom: 1px solid #24242e;
  padding: 15px 0;
  background: transparent;
  color: #dedee8;
  text-align: left;
}

.habit-row:first-child {
  padding-top: 0;
}

.habit-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.habit-emoji {
  width: 37px;
  height: 37px;
  display: grid;
  place-items: center;
  border: 1px solid #292835;
  background: #1b1a25;
  border-radius: 10px;
  font-size: 17px;
}

.habit-name {
  flex: 1;
  font-size: 12px;
  font-weight: 600;
}

.habit-done .habit-name {
  color: #858596;
  text-decoration: line-through;
}

.habit-check {
  border-radius: 50%;
}

.empty-state {
  text-align: center;
  padding: 30px 10px;
  color: var(--muted);
  font-size: 13px;
}

.focus-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 22px;
  background:
    radial-gradient(ellipse at 80% 50%, #8060d81a, transparent 60%),
    var(--panel);
}

.focus-panel h2 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 20px;
  letter-spacing: -.5px;
  margin-bottom: 8px;
}

/* RESOURCES */

.page-heading {
  margin-bottom: 26px;
}

.page-heading h1 {
  margin-bottom: 10px;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12px;
  max-width: 550px;
  padding: 13px 16px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: var(--panel);
  color: #777789;
  margin-bottom: 24px;
}

.search-box input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: none;
  outline: none;
  color: white;
  font-size: 13px;
}

.search-box input::placeholder {
  color: #777789;
}

.resource-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 17px;
}

.resource-card {
  display: flex;
  flex-direction: column;
  min-height: 205px;
  padding: 21px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--panel);
  text-decoration: none;
  color: #eeeef5;
  transition: all .2s;
}

.resource-card:hover {
  border-color: #8e72ed;
  transform: translateY(-3px);
  background: #17151f;
}

.resource-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #9e8aef;
  margin-bottom: 18px;
}

.resource-category {
  background: #2b2440;
  border: 1px solid #443665;
  border-radius: 6px;
  padding: 5px 8px;
  color: #bcaeff;
  font-size: 10px;
}

.resource-card h3 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 16px;
  margin-bottom: 10px;
}

.resource-card p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
  margin-bottom: 20px;
}

.resource-link {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: auto;
  color: #b5a2ff;
  font-size: 12px;
  font-weight: 700;
}

/* COMING SOON */

.coming-soon {
  max-width: 650px;
  margin: 80px auto;
  text-align: center;
  padding: 55px 35px;
}

.coming-icon {
  color: var(--purple-light);
  margin-bottom: 25px;
}

.coming-soon h1 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 30px;
  margin-bottom: 12px;
}

.coming-soon p {
  max-width: 420px;
  margin: 0 auto;
}

.coming-badge {
  display: block;
  width: fit-content;
  margin: 25px auto;
  padding: 8px 13px;
  border-radius: 30px;
  background: #2a2440;
  border: 1px solid #49386d;
  color: #bcaeff;
  font-size: 11px;
  font-weight: 600;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  color: #626273;
  font-size: 10px;
  padding: 30px 2px 10px;
}

.mobile-overlay {
  display: none;
}

/* RESPONSIVE */

@media (max-width: 1150px) {
  .sidebar {
    width: 230px;
    min-width: 230px;
  }

  .page-content {
    padding: 27px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .resource-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 760px) {
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    height: 100dvh;
    width: 270px;
    min-width: 270px;
    transform: translateX(-100%);
    transition: transform .25s ease;
    box-shadow: 15px 0 45px #00000060;
  }

  .sidebar-open {
    transform: translateX(0);
  }

  .mobile-overlay {
    display: block;
    position: fixed;
    inset: 0;
    background: #00000090;
    border: none;
    z-index: 19;
  }

  .mobile-close {
    display: grid !important;
    margin-left: auto;
  }

  .menu-toggle {
    display: grid !important;
  }

  .topbar {
    height: 65px;
    padding: 0 16px;
  }

  .topbar-left, .topbar-right {
    gap: 10px;
  }

  .status-pill {
    padding: 7px 9px;
    font-size: 10px;
  }

  .breadcrumb {
    font-size: 11px;
  }

  .breadcrumb span {
    margin: 0 5px;
  }

  .page-content {
    padding: 25px 16px;
  }

  .welcome {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 24px;
  }

  .welcome h1, .page-heading h1 {
    font-size: 27px;
  }

  .date-chip {
    font-size: 11px;
  }

  .stats-grid {
    gap: 12px;
  }

  .stat-card {
    padding: 16px;
  }

  .stat-top {
    font-size: 11px;
  }

  .stat-value {
    font-size: 27px;
  }

  .panel {
    padding: 18px;
  }

  .panel-header {
    gap: 10px;
  }

  .panel-title {
    font-size: 15px;
  }

  .panel-subtitle {
    font-size: 11px;
  }

  .primary-btn {
    padding: 9px 11px;
    font-size: 11px;
  }

  .focus-panel {
    flex-direction: column;
    align-items: flex-start;
  }

  .resource-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .footer {
    flex-direction: column;
    padding-top: 25px;
  }

  .delete-btn {
    opacity: 1;
  }
}

@media (max-width: 380px) {
  .stats-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .top-avatar {
    display: none;
  }

  .panel-header {
    flex-wrap: wrap;
  }
}